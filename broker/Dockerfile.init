FROM golang:1.27.1-alpine3.24 AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 \
    GOOS=linux \
    go build \
    -trimpath \
    -o /out/broker-init \
    ./init

FROM alpine:3.24

RUN adduser \
    -D \
    -H \
    -u 10001 \
    user

USER user

COPY --from=builder \
    /out/broker-init \
    /broker-init

ENTRYPOINT ["/broker-init"]
