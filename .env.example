# Copy the relevant variables manually into each service's .env.
# Shared variables must match in all services listed below.
# Set DATABASE_URL to match the credentials in store/.env.
# Keep real secrets in the gitignored service files, not in this template.

# --- root .env: required Docker Compose host ports (copy only this section) ---
# These example values avoid commonly occupied development ports. Choose other free
# ports here if needed; service env_file entries do not set Compose mappings.
# Every setting for each service is required; missing/empty values prevent startup.
CLIENT_API_HOST_PORT=18080
BMKG_HOST_PORT=18081
PVMBG_HOST_PORT=18082
SCHEMA_REGISTRY_HOST_PORT=18084
NATS_HOST_PORT=14222
NATS_MONITOR_HOST_PORT=18222
# Explicit address: 127.0.0.1 for host-only access; 0.0.0.0 for other machines.
# No runtime defaults. Both variables are required by Compose.
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_HOST_PORT=13000
# Service ports and URLs below are inside containers and stay unchanged.
# For a TUI running on the host, use BNPB_API_URL=http://localhost:18080.

# --- bmkg-mock/.env; BMKG_API_KEY is also used by aggregator/.env ---
BMKG_PORT=8081
BMKG_API_KEY=changeme-bmkg-key
BMKG_DELAY_MS=100
# One new seismic event per interval; 1-10000 (lower it to speed up a demo).
BMKG_EVENT_INTERVAL_MS=10000

# --- pvmbg-mock/.env; PVMBG_TOKEN is also used by aggregator/.env ---
PVMBG_PORT=8082
PVMBG_TOKEN=changeme-pvmbg-token
PVMBG_ADMIN_TOKEN=changeme-pvmbg-admin-token
PVMBG_MIN_DELAY_MS=500
PVMBG_MAX_DELAY_MS=3000
# One new volcanic report per interval; 1-10000 (lower it to speed up a demo).
PVMBG_REPORT_INTERVAL_MS=10000

# --- aggregator/.env ---
AGGREGATOR_PORT=8080
POLL_INTERVAL=3
BMKG_BASE_URL=http://bmkg-mock:8081
PVMBG_BASE_URL=http://pvmbg-mock:8082

# --- store/.env ---
POSTGRES_DB=hazards
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme-postgres-password

# --- aggregator/.env; must match store/.env credentials ---
DATABASE_URL=postgres://postgres:changeme-postgres-password@postgres:5432/hazards?sslmode=disable

# --- broker/.env; URL, stream and subject are also used by aggregator/.env ---
NATS_URL=nats://broker:4222
NATS_STREAM=HAZARDS
NATS_SUBJECT=hazard.events
NATS_STREAM_MAX_AGE=24h

# --- auth-service/.env ---
AUTH_PORT=8083
AUTH_DB_PATH=/data/auth.db
# Also used by client-api/.env.
AUTH_INTERNAL_KEY=replace-with-random-internal-key
ACCESS_TOKEN_TTL_SEC=60
REFRESH_TOKEN_TTL_SEC=86400
# Client IDs are also used by client-tui/.env; secrets are only in Auth.
MEDIA_CLIENT_ID=media-demo
MEDIA_CLIENT_SECRET=replace-with-media-secret
FIELD_CLIENT_ID=field-demo
FIELD_CLIENT_SECRET=replace-with-field-secret
INTERNAL_CLIENT_ID=internal-demo
INTERNAL_CLIENT_SECRET=replace-with-internal-secret

# --- client-api/.env ---
CLIENT_API_PORT=8080
AUTH_BASE_URL=http://auth-service:8083
AGGREGATOR_BASE_URL=http://aggregator:8080
# Max concurrent requests; extra requests get 429. 0 disables the limit.
CLIENT_API_MAX_INFLIGHT=128

# --- client-tui/.env ---
BNPB_API_URL=http://client-api:8080

# --- registry/.env (Apicurio + its own Postgres; values must match) ---
# POSTGRES_PASSWORD and APICURIO_DATASOURCE_PASSWORD are the same secret.
POSTGRES_DB=registry
POSTGRES_USER=registry
POSTGRES_PASSWORD=changeme-registry-password
APICURIO_STORAGE_KIND=sql
APICURIO_STORAGE_SQL_KIND=postgresql
APICURIO_DATASOURCE_URL=jdbc:postgresql://registry-db:5432/registry
APICURIO_DATASOURCE_USERNAME=registry
APICURIO_DATASOURCE_PASSWORD=changeme-registry-password
# Required by the Registry supervisor; retry initialization after an exit.
REGISTRY_RETRY_DELAY_SEC=5

# --- SCHEMA_REGISTRY_URL: bmkg-mock, pvmbg-mock, aggregator and both consumers ---
SCHEMA_REGISTRY_URL=http://schema-registry:8080/apis/ccompat/v7

# --- broker/.env DLQ settings; NATS_DLQ_STREAM is also used by both consumers ---
NATS_DLQ_STREAM=HAZARDS_DLQ
NATS_DLQ_SUBJECT_PREFIX=hazard.dlq
NATS_DLQ_MAX_AGE=168h

# --- consumer-dashboard/.env (use notifier/8092/notifier-v1/hazard.dlq.notifier for consumer-notifier/.env) ---
CONSUMER_ROLE=dashboard
CONSUMER_PORT=8091
CONSUMER_DB_PATH=/data/dashboard.db
NATS_DURABLE=dashboard-v1
NATS_DLQ_SUBJECT=hazard.dlq.dashboard
# Also needs NATS_URL, NATS_STREAM, NATS_SUBJECT, SCHEMA_REGISTRY_URL, NATS_DLQ_STREAM from above.

# --- both source mocks: source-owned SQLite archive; Compose mounts separate volumes ---
SOURCE_ARCHIVE_PATH=/data/history.db
# --- aggregator/.env: demo freshness thresholds, measured from successful source checks ---
BMKG_FRESHNESS_SEC=60
PVMBG_FRESHNESS_SEC=1800
# Bounded retry delay; retries have no maximum count and survive restart.
SOURCE_RETRY_MAX_SEC=60
# --- broker, aggregator, and both consumers: additive lifecycle stream ---
NATS_LIFECYCLE_STREAM=REPORT_LIFECYCLE
NATS_LIFECYCLE_SUBJECT=report.lifecycle
# broker only; explicit lifecycle retention. Must not exceed DLQ retention.
NATS_LIFECYCLE_MAX_AGE=24h

# --- monitoring/grafana/.env ---
GF_SECURITY_ADMIN_USER=monitoring-admin
GF_SECURITY_ADMIN_PASSWORD=replace-with-random-grafana-password
PROMETHEUS_URL=http://prometheus:9090
LOKI_URL=http://loki:3100
# Match the broker's explicitly configured NATS_DLQ_STREAM.
DLQ_STREAM_NAME=HAZARDS_DLQ

# --- monitoring/prometheus/.env ---
METRICS_RETENTION_DAYS=30
ALLOY_METRICS_URL=http://alloy:12345/metrics
LOKI_METRICS_URL=http://loki:3100/metrics
NATS_EXPORTER_METRICS_URL=http://nats-exporter:7777/metrics

# --- monitoring/nats-exporter/.env ---
NATS_MONITOR_URL=http://broker:8222

# --- monitoring/loki/.env ---
LOG_RETENTION_DAYS=30

# --- monitoring/alloy/.env ---
# COMPOSE_PROJECT_NAME is supplied by Compose, including when -p is used.
PROMETHEUS_WRITE_URL=http://prometheus:9090/api/v1/write
LOKI_PUSH_URL=http://loki:3100/loki/api/v1/push
# Match each service's explicitly configured container port.
BMKG_HEALTH_URL=http://bmkg-mock:8081/health
PVMBG_HEALTH_URL=http://pvmbg-mock:8082/health
AGGREGATOR_HEALTH_URL=http://aggregator:8080/health
AGGREGATOR_READY_URL=http://aggregator:8080/ready
AUTH_HEALTH_URL=http://auth-service:8083/health
CLIENT_API_HEALTH_URL=http://client-api:8080/health
CLIENT_API_READY_URL=http://client-api:8080/ready
DASHBOARD_HEALTH_URL=http://consumer-dashboard:8091/health
DASHBOARD_READY_URL=http://consumer-dashboard:8091/ready
NOTIFIER_HEALTH_URL=http://consumer-notifier:8092/health
NOTIFIER_READY_URL=http://consumer-notifier:8092/ready
REGISTRY_READY_URL=http://schema-registry:9000/health/ready
NATS_HEALTH_URL=http://broker:8222/healthz
