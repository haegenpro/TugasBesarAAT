# Values are required private Secret keys. Replace every placeholder; do not
# commit the resulting file. Use the actual instructor audit token.
HISTORY_SERVICE_TOKEN=<dedicated-history-token>
INGESTION_SERVICE_TOKEN=<dedicated-ingestion-service-token>
AUDIT_TOKEN=<instructor-audit-token>
AUDIT_CURSOR_KEY=<random-secret-at-least-32-bytes-shared-by-all-aggregators>
INGESTION_CURSOR_KEY=<different-random-secret-at-least-32-bytes-shared-by-ingestion>
AUTH_INTERNAL_KEY=<existing-auth-service-internal-key>
BMKG_API_KEY=<existing-bmkg-source-key>
NATS_URL=<private-authenticated-broker-url>
