# Values are required private Secret keys. Replace every placeholder; do not
# commit the resulting file. Use the actual instructor audit token.
HISTORY_SERVICE_TOKEN=<dedicated-history-token>
INGESTION_SERVICE_TOKEN=<dedicated-ingestion-service-token>
AUDIT_TOKEN=<instructor-audit-token>
AUDIT_CURSOR_KEY=<random-secret-at-least-32-bytes-shared-by-all-aggregators>
INGESTION_CURSOR_KEY=<different-random-secret-at-least-32-bytes-shared-by-ingestion>
AUTH_INTERNAL_KEY=<existing-auth-service-internal-key>
BMKG_API_KEY=<existing-bmkg-source-key>
NATS_URL=<private-authenticated-broker-url>
# Optional analytics: supply a distinct shared Aggregator/Client API credential
# before enabling ANALYTICS_ENABLED in either service. Never send it to browsers.
# ANALYTICS_SERVICE_TOKEN=GENERATE_A_DISTINCT_SECRET
# Required when the role1 config contains an "r3" block. Every value must be
# distinct from the other credentials in this file.
# FIELD_REPORT_SERVICE_TOKEN=<dedicated-token-shared-with-client-api-runtime>
# SATELLITE_FEED_TOKEN=<group-token-for-the-satellite-feed>
# CANONICAL_SERVICE_TOKEN=<existing-aggregator-canonical-token>
# COASTAL_SLO_TOKEN=<dedicated-read-only-token-also-in-notifier-runtime>
