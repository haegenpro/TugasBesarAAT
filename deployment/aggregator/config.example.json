{
  "version": 1,
  "storage_mode": "postgres",
  "runtime_secret": "aat-m2-aggregator-runtime",
  "storage_secret": "aat-m2-aggregator-storage",
  "durability_configmap": "aat-m2-storage-durability",
  "environment": {
    "BMKG_BASE_URL": "http://bmkg-mock:8081",
    "PVMBG_BASE_URL": "http://pvmbg-mock:8082",
