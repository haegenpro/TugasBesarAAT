BMKG_API_KEY=replace-with-bmkg-source-key
PVMBG_TOKEN=replace-with-distinct-pvmbg-source-token
CANONICAL_SERVICE_TOKEN=replace-with-dedicated-canonical-service-secret
PROCESSOR_SERVICE_TOKEN=replace-with-distinct-processor-service-secret
