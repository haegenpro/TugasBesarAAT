# Copy privately; use distinct generated hexadecimal passwords, shared by the
# three broker servers. NATS_SYSTEM_URL belongs only in broker-runtime.
NATS_APP_USER=application
NATS_APP_PASSWORD=REPLACE_WITH_GENERATED_APP_PASSWORD
NATS_SYSTEM_USER=platform-system
NATS_SYSTEM_PASSWORD=REPLACE_WITH_DIFFERENT_GENERATED_SYSTEM_PASSWORD
NATS_URL=nats://application:REPLACE_WITH_GENERATED_APP_PASSWORD@broker:4222
NATS_SYSTEM_URL=nats://platform-system:REPLACE_WITH_DIFFERENT_GENERATED_SYSTEM_PASSWORD@broker:4222
