{
  "version": 1,
  "external": [
    "registry-db",
    "auth-db",
    "dashboard-db",
    "notifier-db"
  ],
  "services": [
    {
      "name": "broker",
      "role": "broker",
      "kind": "StatefulSet",
      "replicas": 3,
      "image_key": "broker",
      "secret": "broker-runtime",
      "ports": {
        "client": 4222,
        "monitor": 8222,
        "route": 6222
      },
      "environment": {
        "NATS_PORT": "4222",
        "NATS_MONITOR_PORT": "8222"
      },
      "command": [
        "nats-server",
        "--config",
        "/etc/nats/nats.conf"
      ],
      "config_mounts": [
        {
          "name": "broker-config",
          "path": "/etc/nats"
        }
      ],
      "storage": {
        "path": "/data",
        "size": "10Gi",
        "uid": 10001
      },
      "ready": {
        "path": "/healthz?js-enabled-only=true",
        "port": 8222
      },
      "live": {
        "path": "/healthz",
        "port": 8222
      },
      "dependencies": [],
      "required_secret_keys": [
        "NATS_APP_USER",
        "NATS_APP_PASSWORD",
        "NATS_SYSTEM_USER",
        "NATS_SYSTEM_PASSWORD",
        "NATS_URL",
        "NATS_SYSTEM_URL"
      ]
    },
    {
      "name": "broker-init",
      "role": "other",
      "kind": "Job",
      "replicas": 1,
      "image_key": "broker",
      "secret": "broker-init-runtime",
      "ports": {},
      "environment": {
        "NATS_PORT": "4222",
        "NATS_MONITOR_PORT": "8222",
        "NATS_REPLICAS": "3",
        "NATS_STREAM": "HAZARDS",
        "NATS_SUBJECT": "hazard.events",
        "NATS_STREAM_MAX_AGE": "24h",
        "NATS_DLQ_STREAM": "HAZARDS_DLQ",
        "NATS_DLQ_SUBJECT_PREFIX": "hazard.dlq",
        "NATS_DLQ_MAX_AGE": "168h",
        "NATS_LIFECYCLE_STREAM": "REPORT_LIFECYCLE",
        "NATS_LIFECYCLE_SUBJECT": "report.lifecycle",
        "NATS_LIFECYCLE_MAX_AGE": "24h",
        "NATS_MAX_BYTES": "268435456"
      },
      "command": [
        "/usr/local/bin/broker-init"
      ],
      "dependencies": [
        "broker"
      ],
      "required_secret_keys": [
        "NATS_URL"
      ]
    },
    {
      "name": "schema-registry",
      "role": "other",
      "kind": "Deployment",
      "replicas": 1,
      "image_key": "schema-registry",
      "secret": "registry-runtime",
      "ports": {
        "http": 8080,
        "management": 9000
      },
      "environment": {
        "QUARKUS_HTTP_PORT": "8080",
        "QUARKUS_MANAGEMENT_PORT": "9000",
        "APICURIO_DATASOURCE_URL": "jdbc:postgresql://registry-db:5432/registry",
        "APICURIO_STORAGE_KIND": "sql",
        "APICURIO_STORAGE_SQL_KIND": "postgresql",
        "APICURIO_SQL_INIT": "false",
        "REGISTRY_RETRY_DELAY_SEC": "5"
      },
      "ready": {
        "path": "/health/ready",
        "port": 9000
      },
      "live": {
        "path": "/health/live",
        "port": 9000
      },
      "read_only_root": false,
      "dependencies": [
        "registry-db"
      ],
      "required_secret_keys": [
        "APICURIO_DATASOURCE_USERNAME",
        "APICURIO_DATASOURCE_PASSWORD"
      ]
    },
    {
      "name": "bmkg-mock",
      "role": "mock",
      "kind": "StatefulSet",
      "replicas": 1,
      "image_key": "bmkg-mock",
      "secret": "bmkg-runtime",
      "ports": {
        "http": 8081
      },
      "environment": {
        "BMKG_PORT": "8081",
        "SCHEMA_REGISTRY_URL": "http://schema-registry:8080/apis/ccompat/v7",
        "SOURCE_ARCHIVE_PATH": "/data/archive.json",
        "OTEL_EXPORTER_OTLP_ENDPOINT": "http://tempo:4318",
        "BMKG_DELAY_MS": "100",
        "BMKG_EVENT_INTERVAL_MS": "10000"
      },
      "storage": {
        "path": "/data",
        "size": "1Gi",
        "uid": 10001
      },
      "ready": {
        "path": "/health",
        "port": 8081
      },
      "live": {
        "path": "/health",
        "port": 8081
      },
      "dependencies": [
        "schema-registry"
      ],
      "metrics_port": 8081,
      "required_secret_keys": [
        "BMKG_API_KEY"
      ]
    },
    {
      "name": "pvmbg-mock",
      "role": "mock",
      "kind": "StatefulSet",
      "replicas": 1,
      "image_key": "pvmbg-mock",
      "secret": "pvmbg-runtime",
      "ports": {
        "http": 8082
      },
      "environment": {
        "PVMBG_PORT": "8082",
        "SCHEMA_REGISTRY_URL": "http://schema-registry:8080/apis/ccompat/v7",
        "SOURCE_ARCHIVE_PATH": "/data/archive.json",
        "OTEL_EXPORTER_OTLP_ENDPOINT": "http://tempo:4318",
        "PVMBG_MIN_DELAY_MS": "500",
        "PVMBG_MAX_DELAY_MS": "1500",
        "PVMBG_REPORT_INTERVAL_MS": "10000"
      },
      "storage": {
        "path": "/data",
        "size": "1Gi",
        "uid": 10001
      },
      "ready": {
        "path": "/health",
        "port": 8082
      },
      "live": {
        "path": "/health",
        "port": 8082
      },
      "dependencies": [
        "schema-registry"
      ],
      "metrics_port": 8082,
      "required_secret_keys": [
        "PVMBG_TOKEN",
        "PVMBG_ADMIN_TOKEN"
      ]
    },
    {
      "name": "auth-service",
      "role": "api",
      "kind": "Deployment",
      "replicas": 3,
      "image_key": "auth-service",
      "secret": "auth-runtime",
      "ports": {
        "http": 8083
      },
      "environment": {
        "AUTH_PORT": "8083",
        "OTEL_EXPORTER_OTLP_ENDPOINT": "http://tempo:4318",
        "AUTH_PRIORITY_ENABLED": "true",
        "AUTH_MAX_INFLIGHT": "32",
        "AUTH_FIELD_RESERVED": "8",
        "AUTH_DB_FIELD_RESERVED": "4",
        "DB_MAX_OPEN_CONNS": "16",
        "ACCESS_TOKEN_TTL_SEC": "900",
        "REFRESH_TOKEN_TTL_SEC": "86400"
      },
      "ready": {
        "path": "/ready",
        "port": 8083
      },
      "live": {
        "path": "/health",
        "port": 8083
      },
      "dependencies": [
        "auth-db"
      ],
      "metrics_port": 8083,
      "required_secret_keys": [
        "DATABASE_URL",
        "AUTH_INTERNAL_KEY",
        "AUTH_PRIORITY_KEY",
        "MEDIA_CLIENT_ID",
        "MEDIA_CLIENT_SECRET",
        "FIELD_CLIENT_ID",
        "FIELD_CLIENT_SECRET",
        "INTERNAL_CLIENT_ID",
        "INTERNAL_CLIENT_SECRET"
      ]
    },
    {
      "name": "client-api",
      "role": "api",
      "kind": "Deployment",
      "replicas": 3,
      "image_key": "client-api",
      "secret": "client-api-runtime",
      "ports": {
        "http": 8080
      },
      "environment": {
        "CLIENT_API_PORT": "8080",
        "ANALYTICS_ENABLED": "false",
        "AUTH_BASE_URL": "http://auth-service:8083",
        "AGGREGATOR_BASE_URL": "http://aggregator:8080",
        "OTEL_EXPORTER_OTLP_ENDPOINT": "http://tempo:4318",
        "CLIENT_API_PRIORITY_ENABLED": "true",
        "CLIENT_API_MAX_INFLIGHT": "128",
        "CLIENT_API_MAX_INFLIGHT_PER_CLIENT": "32",
        "CLIENT_API_FIELD_RESERVED": "32",
        "CLIENT_API_AUTH_MAX_INFLIGHT": "32",
        "INGESTION_BASE_URL": "http://ingestion:8080",
        "CLIENT_API_AUTH_FIELD_RESERVED": "8"
      },
      "ready": {
        "path": "/ready",
        "port": 8080
      },
      "live": {
        "path": "/health",
        "port": 8080
      },
      "dependencies": [
        "auth-service",
        "aggregator"
      ],
      "metrics_port": 8080,
      "required_secret_keys": [
        "AUTH_INTERNAL_KEY",
        "ANALYTICS_SERVICE_TOKEN",
        "FIELD_REPORT_SERVICE_TOKEN",
        "AUTH_PRIORITY_KEY",
        "FIELD_READ_TOKEN"
      ]
    },
    {
      "name": "consumer-dashboard",
      "role": "consumer",
      "kind": "Deployment",
      "replicas": 3,
      "image_key": "consumer-dashboard",
      "secret": "dashboard-runtime",
      "ports": {
        "http": 8091
      },
      "environment": {
        "SCHEMA_REGISTRY_URL": "http://schema-registry:8080/apis/ccompat/v7",
        "OTEL_EXPORTER_OTLP_ENDPOINT": "http://tempo:4318",
        "CONSUMER_ROLE": "dashboard",
        "CONSUMER_PORT": "8091",
        "CONSUMER_ADMIN_SOCKET": "/tmp/dashboard-admin.sock",
        "NATS_STREAM": "HAZARDS",
        "NATS_SUBJECT": "hazard.events",
        "NATS_DURABLE": "dashboard-main-v1",
        "NATS_DLQ_STREAM": "HAZARDS_DLQ",
        "NATS_DLQ_SUBJECT": "hazard.dlq.dashboard",
        "NATS_LIFECYCLE_STREAM": "REPORT_LIFECYCLE",
        "NATS_LIFECYCLE_SUBJECT": "report.lifecycle",
        "CONSUMER_WORKERS": "4",
        "NATS_MAX_ACK_PENDING": "64"
      },
      "ready": {
        "path": "/ready",
        "port": 8091
      },
      "live": {
        "path": "/health",
        "port": 8091
      },
      "dependencies": [
        "dashboard-db",
        "broker-init",
        "schema-registry"
      ],
      "metrics_port": 8091,
      "required_secret_keys": [
        "DATABASE_URL",
        "NATS_URL"
      ]
    },
    {
      "name": "consumer-notifier",
      "role": "consumer",
      "kind": "Deployment",
      "replicas": 3,
      "image_key": "consumer-notifier",
      "secret": "notifier-runtime",
      "ports": {
        "http": 8092
      },
      "environment": {
        "SCHEMA_REGISTRY_URL": "http://schema-registry:8080/apis/ccompat/v7",
        "OTEL_EXPORTER_OTLP_ENDPOINT": "http://tempo:4318",
        "WARNING_STREAM": "BNPB_CRITICAL",
        "WARNING_SUBJECT": "bnpb.warning.coastal",
        "WARNING_DURABLE": "tim-lapangan-v1",
        "WARNING_EXPECTATIONS_URL": "http://coastal-processor:8080",
        "WARNING_SLO_METRICS_ENABLED": "true",
        "CONSUMER_ROLE": "notifier",
        "CONSUMER_PORT": "8092",
        "CONSUMER_ADMIN_SOCKET": "/tmp/notifier-admin.sock",
        "NATS_STREAM": "HAZARDS",
        "NATS_SUBJECT": "hazard.events",
        "NATS_DURABLE": "notifier-main-v1",
        "NATS_DLQ_STREAM": "HAZARDS_DLQ",
        "NATS_DLQ_SUBJECT": "hazard.dlq.notifier",
        "NATS_LIFECYCLE_STREAM": "REPORT_LIFECYCLE",
        "NATS_LIFECYCLE_SUBJECT": "report.lifecycle",
        "CONSUMER_WORKERS": "4",
        "NATS_MAX_ACK_PENDING": "64"
      },
      "ready": {
        "path": "/ready",
        "port": 8092
      },
      "live": {
        "path": "/health",
        "port": 8092
      },
      "dependencies": [
        "notifier-db",
        "broker-init",
        "schema-registry"
      ],
      "metrics_port": 8092,
      "required_secret_keys": [
        "DATABASE_URL",
        "COASTAL_SLO_TOKEN",
        "NATS_URL"
      ]
    },
    {
      "name": "sensor-pantai",
      "role": "sensor",
      "kind": "StatefulSet",
      "replicas": 1,
      "image": "sustuna/sensor-pantai@sha256:51fbd90d3891ad6e9f5768ad330ffb65205644cb29e50da65c7538f2e0b4397d",
      "secret": "pantai-runtime",
      "ports": {
        "http": 8080
      },
      "environment": {
        "PANTAI_PROFILE": "practice",
        "PANTAI_SEED": "42",
        "PANTAI_SPEED": "60"
      },
      "storage": {
        "path": "/data",
        "size": "1Gi",
        "uid": 10001
      },
      "ready": {
        "path": "/healthz",
        "port": 8080
      },
      "live": {
        "path": "/healthz",
        "port": 8080
      },
      "dependencies": [],
      "required_secret_keys": [
        "PANTAI_AUTH_TOKEN"
      ]
    }
  ],
  "jetstream": {
    "max_file_store_bytes": 8589934592,
    "volume_headroom_bytes": 2147483648,
    "streams": [
      {
        "name": "HAZARDS",
        "max_bytes": 268435456,
        "replicas": 3
      },
      {
        "name": "REPORT_LIFECYCLE",
        "max_bytes": 268435456,
        "replicas": 3
      },
      {
        "name": "HAZARDS_DLQ",
        "max_bytes": 268435456,
        "replicas": 3
      },
      {
        "name": "BNPB_RAW_BMKG",
        "max_bytes": 1073741824,
        "replicas": 3
      },
      {
        "name": "BNPB_RAW_SATELLITE",
        "max_bytes": 1073741824,
        "replicas": 3
      },
      {
        "name": "BNPB_RAW_REPORTS",
        "max_bytes": 1073741824,
        "replicas": 3
      },
      {
        "name": "BNPB_RAW_COASTAL",
        "max_bytes": 1073741824,
        "replicas": 3
      },
      {
        "name": "BNPB_CRITICAL",
        "max_bytes": 1073741824,
        "replicas": 3
      }
    ]
  }
}
