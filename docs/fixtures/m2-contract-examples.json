    },
    {
      "name": "restoration_overrides_ordinary_survivor",
      "before": {
        "active_parent": "X",
        "membership": [
          "A",
          "B",
          "C",
          "D"
        ],
        "earliest_key": "A",
        "inactive_history": [
          {
            "identity": "H",
            "membership": [
              "A",
              "B"
            ],
            "deactivated_position": 5
          }
        ]
      },
      "split_children": [
        [
          "A",
          "B"
        ],
        [
          "C",
          "D"
        ]
      ],
      "expected": {
        "AB": "H",
        "CD": "X"
      },
      "rule": "Restore H first, then the earliest unmatched qualifying child retains X."
    },
    {
      "name": "all_children_historically_restored",
      "before": {
        "active_parent": "X",
        "inactive_history": [
          {
            "identity": "H",
            "membership": [
              "A",
              "B"
            ],
            "deactivated_position": 5
          },
          {
            "identity": "J",
            "membership": [
              "C",
              "D"
            ],
            "deactivated_position": 6
          }
        ]
      },
      "split_children": [
        [
          "A",
          "B"
        ],
        [
          "C",
          "D"
        ]
      ],
      "expected": {
        "AB": "H",
        "CD": "J",
        "inactive": [
          "X"
        ]
      }
    },
    {
      "name": "multiple_exact_historical_matches",
