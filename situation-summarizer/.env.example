SUMMARIZER_PORT=8094
AGGREGATOR_BASE_URL=http://aggregator:8080

# Isi dengan API key OpenRouter (https://openrouter.ai/keys). Jangan di-commit.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

SUMMARY_MODEL=baidu/ernie-5.5-flash-preview:free
SUMMARY_FALLBACK_MODELS=nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free

SUMMARY_WINDOW=2h
SUMMARY_CHECK_INTERVAL=1m
SUMMARY_REFRESH_INTERVAL=30m
SUMMARY_URGENT_DELAY=30s
SUMMARY_MIN_CALL_INTERVAL=2m
SUMMARY_LLM_TIMEOUT=45s
SUMMARY_MAX_CALLS_PER_DAY=45
SUMMARY_MAX_HIGHLIGHTS=8

# off untuk operasi normal; slow atau invalid hanya untuk demo bonus.
SUMMARY_FAULT_MODE=off
