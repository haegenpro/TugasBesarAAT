SUMMARIZER_PORT=8094
AGGREGATOR_BASE_URL=http://aggregator:8080

# Isi dengan API key OpenRouter (https://openrouter.ai/keys). Jangan di-commit.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

SUMMARY_MODEL=nvidia/nemotron-3.5-super-vl:free
SUMMARY_FALLBACK_MODELS=baidu/ernie-5.5-flash-preview:free,google/gemma-4-31b-it:free

SUMMARY_WINDOW=2h
SUMMARY_CHECK_INTERVAL=1m
SUMMARY_REFRESH_INTERVAL=30m
SUMMARY_URGENT_DELAY=30s
SUMMARY_MIN_CALL_INTERVAL=2m
SUMMARY_LLM_TIMEOUT=60s
SUMMARY_MAX_CALLS_PER_DAY=45
SUMMARY_MAX_HIGHLIGHTS=8

# Batas token per panggilan LLM (reasoning + jawaban). Maksimal 32000 karena batas output Gemma.
LLM_MAX_TOKENS=16000
LLM_REASONING_TOKENS=2048

# Chat interaktif: POST /situation/chat di client-api.
CHAT_TIMEOUT=60s
CHAT_MAX_CALLS_PER_DAY=150
CHAT_MAX_CONCURRENT=2
CHAT_MAX_HISTORY=8

# off untuk operasi normal; slow atau invalid hanya untuk demo bonus.
SUMMARY_FAULT_MODE=off
