global:
  scrape_interval: 15s
  scrape_timeout: 10s
storage:
  tsdb:
    retention:
      time: {{.METRICS_RETENTION_DAYS}}d
scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: [{{quote (printf "localhost:%s" .PROMETHEUS_PORT)}}]
  - job_name: alloy
    metrics_path: {{quote (urlPath .ALLOY_METRICS_URL)}}
    static_configs:
      - targets: [{{quote (urlHost .ALLOY_METRICS_URL)}}]
    scheme: {{quote (urlScheme .ALLOY_METRICS_URL)}}
  - job_name: loki
    metrics_path: {{quote (urlPath .LOKI_METRICS_URL)}}
    static_configs:
      - targets: [{{quote (urlHost .LOKI_METRICS_URL)}}]
    scheme: {{quote (urlScheme .LOKI_METRICS_URL)}}
  - job_name: nats-exporter
    metrics_path: {{quote (urlPath .NATS_EXPORTER_METRICS_URL)}}
    static_configs:
      - targets: [{{quote (urlHost .NATS_EXPORTER_METRICS_URL)}}]
    scheme: {{quote (urlScheme .NATS_EXPORTER_METRICS_URL)}}
  - job_name: bmkg-mock
    static_configs:
      - targets: [{{quote (printf "bmkg-mock:%s" .BMKG_PORT)}}]
  - job_name: pvmbg-mock
    static_configs:
      - targets: [{{quote (printf "pvmbg-mock:%s" .PVMBG_PORT)}}]
  - job_name: aggregator
    static_configs:
      - targets: [{{quote (printf "aggregator:%s" .AGGREGATOR_PORT)}}]
  - job_name: auth-service
    static_configs:
      - targets: [{{quote (printf "auth-service:%s" .AUTH_PORT)}}]
  - job_name: client-api
    static_configs:
      - targets: [{{quote (printf "client-api:%s" .CLIENT_API_PORT)}}]
  - job_name: consumer-dashboard
    static_configs:
      - targets: [{{quote (printf "consumer-dashboard:%s" .DASHBOARD_PORT)}}]
  - job_name: consumer-notifier
    static_configs:
      - targets: [{{quote (printf "consumer-notifier:%s" .NOTIFIER_PORT)}}]
