apiVersion: 1
prune: true
datasources:
  - name: Prometheus
    uid: prometheus
    type: prometheus
    access: proxy
    url: {{quote .PROMETHEUS_URL}}
    isDefault: true
    editable: false
  - name: Loki
    uid: loki
    type: loki
    access: proxy
    url: {{quote .LOKI_URL}}
    editable: false
  - name: Tempo
    uid: tempo
    type: tempo
    access: proxy
    url: {{quote .TEMPO_URL}}
    editable: false
    jsonData:
      tracesToLogsV2:
        datasourceUid: loki
