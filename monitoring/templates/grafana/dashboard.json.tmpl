    {
      "id": 8,
      "title": "Logged outbound latency p95",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Derived from existing outbound JSON logs; missing logs display No data. Not end-to-end request latency.",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.95, {service=~\"$service\"} | json | __error__=\"\" | target_service!=\"\" | latency_ms!=\"\" | unwrap latency_ms | __error__=\"\" [$__interval]) by (service, target_service)",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "{{`{{service}} \u2192 {{target_service}}`}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "Logged outbound failures",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Counts logged outbound failures, not a request error rate.",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, target_service) (count_over_time({service=~\"$service\"} | json | __error__=\"\" | target_service!=\"\" | success=\"false\" [$__interval]))",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "{{`{{service}} \u2192 {{target_service}}`}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
